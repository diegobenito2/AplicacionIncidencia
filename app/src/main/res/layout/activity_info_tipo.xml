<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Tipo.Activity_Info_Tipo">

    <TextView
        android:id="@+id/tvCodigoTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="93dp"
        android:layout_marginTop="98dp"
        android:text="Código: "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvinfoCodigoTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="114dp"
        android:layout_marginBottom="57dp"
        android:text="0"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/editNombreTipo"
        app:layout_constraintStart_toStartOf="@+id/editNombreTipo" />


    <TextView
        android:id="@+id/tvNombreTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="31dp"
        android:layout_marginTop="194dp"
        android:text="Nombre: "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editNombreTipo"
        android:layout_width="261dp"
        android:layout_height="51dp"
        android:layout_marginStart="21dp"
        android:layout_marginTop="57dp"
        android:hint="Escribe el nombre"
        android:inputType="text"
        android:text=""
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/tvNombreTipo"
        app:layout_constraintTop_toBottomOf="@+id/tvCodigoTipo" />

    <TextView
        android:id="@+id/tvDescripcionTipo"
        android:layout_width="115dp"
        android:layout_height="29dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="7dp"
        android:text="Descripción: "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/editDescripcionTipo"
        app:layout_constraintEnd_toStartOf="@+id/editDescripcionTipo"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editDescripcionTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="28dp"
        android:inputType="textMultiLine"
        android:text=""
        android:hint="Escribe una descripción del objeto."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvDescripcionTipo"
        app:layout_constraintTop_toBottomOf="@+id/editNombreTipo" />

    <Button
        android:id="@+id/btnGuardarTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnVolverTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="138dp"
        android:layout_marginBottom="16dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>