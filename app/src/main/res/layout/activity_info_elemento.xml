<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Elemento.Activity_Info_Elemento">

    <TextView
        android:id="@+id/tvCodigoElemento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="152dp"
        android:text="Código "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvinfoCodigoElemento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="158dp"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvCodigoElemento"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNombreElemento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="52dp"
        android:text="Nombre "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCodigoElemento" />

    <EditText
        android:id="@+id/edNombreElemento"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="29dp"
        android:layout_marginTop="42dp"
        android:hint="Escribe el Nombre"
        android:inputType="text"
        android:text=""
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvNombreElemento"
        app:layout_constraintTop_toBottomOf="@+id/tvinfoCodigoElemento" />


    <TextView
        android:id="@+id/tvDescripcionElemento"
        android:layout_width="117dp"
        android:layout_height="31dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="122dp"
        android:text="Descripción "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreElemento" />

    <EditText
        android:id="@+id/edDescripcionElemento"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="109dp"
        android:hint="Escribe una descripción"
        android:inputType="textMultiLine"
        android:text=""
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvDescripcionElemento"
        app:layout_constraintTop_toBottomOf="@+id/edNombreElemento" />

    <TextView
        android:id="@+id/tvcodigoTipoElemento"
        android:layout_width="69dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="102dp"
        android:text="Tipo "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescripcionElemento" />

    <Spinner
        android:id="@+id/spinnerTipoElemento"
        android:layout_width="227dp"
        android:layout_height="55dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="72dp"
        android:inputType="textMultiLine"
        android:text="Codigo Tipo "
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoTipoElemento"
        app:layout_constraintTop_toBottomOf="@+id/edDescripcionElemento" />

    <Button
        android:id="@+id/btnGuardarElemento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnBorrarElemento"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="16dp"
        android:text="Borrar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnGuardarElemento"
        app:layout_constraintStart_toEndOf="@+id/btnVolverElemento" />
    <Button
        android:id="@+id/btnVolverElemento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginBottom="16dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>