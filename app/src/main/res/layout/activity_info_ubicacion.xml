<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ubicacion.Activity_Info_Ubicacion">

    <TextView
        android:id="@+id/tvcodigoUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="126dp"
        android:layout_marginEnd="13dp"
        android:layout_marginBottom="12dp"
        android:text="Código "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/edCodigoUbicacion"
        app:layout_constraintEnd_toStartOf="@+id/edCodigoUbicacion"
        app:layout_constraintStart_toStartOf="parent" />


    <EditText
        android:id="@+id/edCodigoUbicacion"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="150dp"
        android:gravity="center"
        android:text="0"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacion"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvcodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="41dp"
        android:text="Sala "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/spinnerSala"
        app:layout_constraintEnd_toStartOf="@+id/spinnerSala"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerSala"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="123dp"
        android:layout_marginBottom="80dp"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvcodigoElemento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoSala"
        app:layout_constraintTop_toBottomOf="@+id/tvcodigoUbicacion" />

    <TextView
        android:id="@+id/tvcodigoElemento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="19dp"
        android:text="Elemento "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/spinnerElemento"
        app:layout_constraintEnd_toStartOf="@+id/spinnerElemento"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerElemento"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="196dp"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="197dp"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tvDescripcionUbicacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoElemento"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoUbicacion" />

    <TextView
        android:id="@+id/tvcodigoUbicacionFechaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="334dp"
        android:text="Fecha Inicio"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvinfocodigoUbicacionFechaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="21dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacionFechaInicio"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoUbicacionFechaInicio" />

    <TextView
        android:id="@+id/tvcodigoUbicacionFechaFin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="41dp"
        android:text="Fecha Fin:  "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvcodigoUbicacionFechaInicio" />

    <TextView
        android:id="@+id/tvinfocodigoUbicacionFechaFin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacionFechaFin"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoUbicacionFechaFin" />

    <TextView
        android:id="@+id/tvDescripcionUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginBottom="18dp"
        android:text="Descripción  "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/edDescripcionUbicacion"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacionFechaFin" />

    <EditText
        android:id="@+id/edDescripcionUbicacion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="99dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="98dp"
        android:gravity="center"
        android:inputType="textMultiLine"
        android:text=""
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverUbicacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvcodigoUbicacionFechaFin" />

    <Button
        android:id="@+id/btnGuardarUbicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnVolverUbicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="182dp"
        android:layout_marginBottom="16dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>