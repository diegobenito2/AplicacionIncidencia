<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ubicacion.Activity_Info_Ubicacion">

    <TextView
        android:id="@+id/tvcodigoUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="49dp"
        android:layout_marginEnd="113dp"
        android:text="Código "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/edCodigoUbicacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edCodigoUbicacion"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="139dp"
        android:layout_marginBottom="43dp"
        android:gravity="center"
        android:text="0"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/edCodigoSala"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacion"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvcodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="161dp"
        android:layout_marginEnd="71dp"
        android:text="Código Sala "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/edCodigoSala"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edCodigoSala"
        android:layout_width="0dp"
        android:layout_height="50sp"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="139dp"
        android:layout_marginBottom="87dp"
        android:gravity="center"
        android:text="0"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/edCodigoElemento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoSala"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoUbicacion" />

    <TextView
        android:id="@+id/tvcodigoElemento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="27dp"
        android:text="Código Elemento "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/edCodigoElemento"
        app:layout_constraintEnd_toStartOf="@+id/edCodigoElemento"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edCodigoElemento"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="139dp"
        android:layout_marginBottom="58dp"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tvinfocodigoUbicacionFechaInicio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoElemento"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoSala" />


    <TextView
        android:id="@+id/tvcodigoUbicacionFechaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="327dp"
        android:layout_marginBottom="328dp"
        android:text="Fecha Inicio"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvcodigoUbicacion" />

    <TextView
        android:id="@+id/tvinfocodigoUbicacionFechaInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="47dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tvinfocodigoUbicacionFechaFin"
        app:layout_constraintEnd_toEndOf="@+id/tvinfocodigoUbicacionFechaFin" />

    <TextView
        android:id="@+id/tvcodigoUbicacionFechaFin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginTop="40dp"
        android:text="Fecha Fin:  "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvcodigoUbicacionFechaInicio" />

    <TextView
        android:id="@+id/tvinfocodigoUbicacionFechaFin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="61dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/tvDescripcionUbicacion"
        app:layout_constraintStart_toEndOf="@+id/tvDescripcionUbicacion" />

    <TextView
        android:id="@+id/tvDescripcionUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="12dp"
        android:text="Descripción  "
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/tvcodigoUbicacionFechaFin"
        app:layout_constraintTop_toBottomOf="@+id/tvcodigoUbicacionFechaFin" />

    <EditText
        android:id="@+id/edDescripcionUbicacion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:inputType="textMultiLine"
        android:text="Contenido Descripción"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@+id/btnVolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescripcionUbicacion" />

    <Button
        android:id="@+id/btnGuardarUbicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Guardar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnVolver" />

    <Button
        android:id="@+id/btnVolverUbicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="138dp"
        android:layout_marginBottom="16dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnGuardar"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>